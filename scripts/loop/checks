#!/usr/bin/env bash
# Финальная проверка цикла на закоммиченном HEAD: `mise run ci` — это весь гейт.
# Кодер запускает один раз перед закрытием отчёта; ревьюер читает итог, а не гоняет то же самое заново.
# Acceptance-сценарии, живые модели и демо сюда не входят: они идут только по явной просьбе владельца
# (docs/agents/rules-tests.md).
# Итог — .loop/cycles/NN/checks.md (первая строка — HEAD), полный лог — .loop/cycles/NN/notes/checks-ci.log
# (не в git, но на диске).
# Использование: scripts/loop/checks NN
set -uo pipefail
cd "$(dirname "$0")/../.."
n=${1:?номер цикла}
dir=.loop/cycles/$n
mkdir -p "$dir/notes"
if [ -n "$(git status --porcelain -- . ':!.loop')" ]; then
  echo "есть незакоммиченные изменения вне .loop — сначала коммит" >&2
  exit 1
fi
out=$dir/checks.md
rows=""
fail=0
step() { # имя, команда...
  local name=$1 t=$SECONDS rc
  shift
  "$@" >"$dir/notes/checks-$name.log" 2>&1
  rc=$?
  [ $rc -eq 0 ] || fail=1
  rows+="| $name | $rc | $((SECONDS - t)) s | notes/checks-$name.log |"$'\n'
}
step ci mise run ci
{
  echo "HEAD: $(git rev-parse HEAD)"
  echo "RESULT: $([ $fail -eq 0 ] && echo pass || echo FAIL)"
  echo "DATE: $(date -u +%Y-%m-%dT%H:%MZ)"
  echo
  echo "| проверка | exit | время | лог |"
  echo "|---|---|---|---|"
  printf '%s' "$rows"
  echo
  echo "nextest: $(grep -h 'Summary' "$dir/notes/checks-ci.log" | tail -1 | sed 's/^ *//')"
} >"$out"
cat "$out"
exit $fail
