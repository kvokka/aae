  "components": {
    "schemas": {
      "AnswerRun": {
        "type": "object",
        "required": [
          "request",
          "answer"
        ],
        "properties": {
          "answer": {
            "description": "`{\"decision\": \"allow\", \"updated_input\"?}`, `{\"decision\": \"deny\", \"message\"}` or\n`{\"decision\": \"answer\", \"text\"}`."
          },
          "request": {
            "type": "string",
            "description": "The id of the open request."
          }
        }
      },
      "CancelRun": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "CloseGate": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "`orchestrator`, `project:<p>`, `rig:<p>/<r>`, `agent:<a>`, `bead:<p>/<id>`, `account:<h>/<id>`,\n`model:<provider>/<model>`."
          },
          "reason": {
            "type": "string"
          },
          "until": {
            "type": [
              "string",
              "null"
            ],
            "description": "`YYYY-MM-DDTHH:MM:SS[.fff]Z`; absent: until opened by hand."
          }
        }
      },
      "CreateRun": {
        "type": "object",
        "required": [
          "project",
          "rig",
          "formula"
        ],
        "properties": {
          "continue_from": {
            "type": [
              "string",
              "null"
            ],
            "description": "A terminal run whose last session this run continues (spec §9.3)."
          },
          "formula": {
            "type": "string",
            "description": "`name` or `<pack>.<name>`, as the project writes it."
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "project": {
            "type": "string"
          },
          "rig": {
            "type": "string"
          }
        }
      },
      "FinishRun": {
        "type": "object",
        "required": [
          "token",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "type": "object",
            "description": "`{\"result\": \"pass\"|\"fail\", \"summary\", \"data\"?}`."
          },
          "token": {
            "type": "string",
            "description": "The attempt token the session got."
          }
        }
      },
      "FireTrigger": {
        "type": "object",
        "required": [
          "project",
          "rig",
          "trigger"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "rig": {
            "type": "string"
          },
          "trigger": {
            "type": "string",
            "description": "`<pack>.<name>`, or the name of a project trigger."
          }
        }
      },
      "OpenGate": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          }
        }
      }
    }
  }
}
