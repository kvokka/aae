            }
          }
        }
      }
    },
    "/v1/instances/{id}/stop": {
      "post": {
        "summary": "Stops an idle instance (`instance.stopped{reason: \"operator\"}`); one that starts or has sessions is refused\n(409), so no attempt loses its process.",
        "operationId": "stop",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
