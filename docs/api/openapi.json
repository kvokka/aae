        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gates/open": {
      "post": {
        "summary": "Opens a gate: every closure of the key goes, the policy's too.",
        "operationId": "open",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
