          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Closes a gate as the operator: automation never opens it (criterion 19).",
        "operationId": "close",
        "parameters": [
          {
            "name": "Idempotency-Key",
