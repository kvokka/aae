{
  "openapi": "3.1.0",
  "info": {
    "title": "aae",
    "description": "The API of the aae daemon (spec §12).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/agents": {
      "get": {
        "summary": "Lists the agents, as `<pack>.<name>` with their harness.",
        "operationId": "list_agents",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "description": "Only this project.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/config/check": {
      "post": {
        "summary": "Loads the config file as a reload would and reports its errors; changes nothing.",
        "operationId": "check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/config/explain": {
      "get": {
        "summary": "The effective config of an agent: one line per value with its layer, and the host layer in one line (spec §6.3).",
        "operationId": "explain",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "description": "`<pack>.<name>`, or a bare name of the project's own pack.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rig",
            "in": "query",
            "description": "The rig of the run; its layer counts when given.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/config/reload": {
      "post": {
        "summary": "Reads the config file again: new runs and the schedules take it, running runs keep their snapshot, idle\ninstances no agent uses any more stop. A file with errors changes nothing (400 with the errors); a change of the\nharnesses or the trackers needs a daemon restart (409). A replayed key answers as before and applies nothing.",
        "operationId": "reload",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/daemon": {
      "get": {
        "summary": "The daemon: its version, process and socket, the journal (last `seq`, failed writes in a row and the last\nerror), the outbox (depth and age of the oldest row, contracts 3.5), the runs in a turn and whether it stops.",
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/daemon/drain": {
      "post": {
        "summary": "Drains the daemon: no run starts from now on (`daemon.stopping{reason: \"drain\"}`), and it exits once no run\nis in a turn or after `timeout_s`. The reply is `{\"seq\": <daemon.stopping>, \"active_runs\": n}`.",
        "operationId": "drain",
        "parameters": [
          {
            "name": "timeout_s",
            "in": "query",
            "description": "How long the runs in a turn may go on, in seconds (default 300); the daemon stops then anyway.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/daemon/restart": {
      "post": {
        "summary": "A drain after which the daemon starts again in the same process (`daemon.stopping{reason: \"restart\"}`);\nrecovery resumes the runs the drain cut (spec §5.6).",
        "operationId": "restart",
        "parameters": [
          {
            "name": "timeout_s",
            "in": "query",
            "description": "How long the runs in a turn may go on, in seconds (default 300); the daemon stops then anyway.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "The events as SSE: `id` is the `seq`, `event` the type, `data` the envelope (contracts 1.1). A `seq` rotated\naway is `410` with `oldest`, the first `seq` still held; it rotated away while streaming: an event `gap`.",
        "operationId": "stream",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "The first `seq` to send; absent: the events after the last written one (or after `Last-Event-ID`).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/formulas": {
      "get": {
        "summary": "Lists the formulas, named as a run start takes them, with their inputs.",
        "operationId": "list_formulas",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "description": "Only this project.",
            "required": false,
            "schema": {
              "type": [
                "string",
