          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gates": {
      "get": {
        "summary": "Every active closure, oldest first.",
        "operationId": "list",
