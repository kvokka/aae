#!/usr/bin/env python3
"""Run a devloop check with private LM paths and no outer run credentials."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

with tempfile.TemporaryDirectory(prefix="devloop-test-") as work:
    env = dict(os.environ)
    for key in os.environ:
        if key.startswith(("LOOP_MANAGER_", "BEADS_", "BD_")) and key != "LOOP_MANAGER_INSTANCE":
            del env[key]
    # The conventional-commits addon injects a git hook through command-scope config.
    # A git commit in a fixture must not inherit the agent's hook or its parameters.
    for key in list(env):
        if key in {"GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS"} or key.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")):
            del env[key]
    # Fixture projects select their own DCG packs.
    env.pop("DCG_CUSTOM_PATHS", None)
    env["DEVLOOP_TEST_ENV"] = "1"
    for kind in ("CONFIG", "STATE", "CACHE", "RUNTIME"):
        path = Path(work, kind.lower())
        path.mkdir(mode=0o700)
        env[f"XDG_{kind}_HOME" if kind != "RUNTIME" else "XDG_RUNTIME_DIR"] = str(path)
    # Pin br even when the check changes directory into a project with a real .beads.
    env["BEADS_DIR"] = str(Path(work, ".beads"))
    sys.exit(subprocess.run(sys.argv[1:], env=env).returncode)
