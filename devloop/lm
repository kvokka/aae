#!/bin/sh
# Select the installed dev binary for the CLI and for commands started by its daemon.
set -eu
bin="$HOME/.local/opt/loop-manager-dev/bin"
export PATH="$bin:$PATH"
export XDG_STATE_HOME="$HOME/.local/state/loop-manager-dev"
export LOOP_MANAGER_SOCKET="$XDG_STATE_HOME/loop-manager/loop-manager.sock"
exec "$bin/loop-manager" "$@"
