#!/bin/sh
# The harness hooks of the context-budget addon, for claude and codex (README.md); the hook's input is on stdin.
#   budget compacted <data dir> <max compactions>   on PostCompact: count, label the bead, stop past the budget
#   budget tool <data dir>                          on PreToolUse: stop a session past its budget
set -eu
input=$(cat)
session=$(printf '%s' "$input" | jq -r '.session_id')
stop="$2/$session.stop"

case $1 in
tool)
    [ -f "$stop" ] || exit 0
    jq -nc --rawfile r "$stop" '{continue: false, stopReason: $r, hookSpecificOutput:
        {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    ;;
compacted)
    # A subagent's or a child thread's compaction is of its own context, not of the session's.
    [ -z "$(printf '%s' "$input" | jq -r '.agent_id // empty')" ] || exit 0
    count="$2/$session.count"
    n=$(($(cat "$count" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$count"
    if [ -n "${LOOP_MANAGER_BEAD:-}" ]; then
        old=$(br label list "$LOOP_MANAGER_BEAD" --json | jq -r '[.[] | select(startswith("compactions:"))] | join(",")') &&
            { [ -z "$old" ] || br label remove "$LOOP_MANAGER_BEAD" -l "$old" >/dev/null; } &&
            br label add "$LOOP_MANAGER_BEAD" -l "compactions:$n" >/dev/null ||
            echo "context-budget: the label compactions:$n is not on $LOOP_MANAGER_BEAD" >&2
    fi
    [ "$n" -gt "$3" ] || exit 0
    reason="context budget: $n compactions"
    # The session stops only on an accepted outcome: a finisher that failed or got a remark leaves it going.
    loop-manager finish fail --summary "$reason" >&2
    printf '%s' "$reason" >"$stop"
    jq -nc --arg r "$reason" '{continue: false, stopReason: $r}'
    ;;
esac
