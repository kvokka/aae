@@ -53,3 +53,37 @@ async fn a_failure_naming_another_model_adds_its_key() {
     let keys: Vec<&str> = keys.as_array().unwrap().iter().filter_map(|k| k.as_str()).collect();
     assert!(keys.ends_with(&["model:acme/m1", "model:acme/m1-2026"]), "{keys:?}");
